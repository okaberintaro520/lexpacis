{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"LexAtlas WorkBuddy output",
  "type":"object","additionalProperties":false,"required":["batch_id","model","items"],
  "properties":{
    "batch_id":{"type":"string"},"model":{"type":"string","minLength":1,"maxLength":120},
    "items":{"type":"array","items":{
      "type":"object","additionalProperties":false,
      "required":["id","content_hash","title_zh","summary_zh","topics","module","evidence_quotes"],
      "properties":{
        "id":{"type":"string"},"content_hash":{"type":"string"},
        "title_zh":{"type":"string","minLength":1,"maxLength":240},
        "summary_zh":{"type":"string","maxLength":600},
        "topics":{"type":"array","uniqueItems":true,"items":{"enum":["disputes","ocean-climate","economic","rights","institutions","theory"]}},
        "module":{"enum":["research","events","official","cases","commentary","news"]},
        "evidence_quotes":{"type":"array","maxItems":8,"items":{"type":"string","minLength":6}},
        "event":{"$ref":"#/$defs/date"},"deadline":{"$ref":"#/$defs/date"}
      }
    }}
  },
  "$defs":{"date":{"oneOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["date","date_text","label"],"properties":{"date":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"},"date_text":{"type":"string"},"label":{"type":"string","maxLength":80}}}]}}
}
